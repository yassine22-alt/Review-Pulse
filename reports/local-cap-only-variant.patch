From a8dd038b037b4e94c772741495885862cc5b4d6e Mon Sep 17 00:00:00 2001
From: ykram051 <wikam5050@gmail.com>
Date: Wed, 18 Nov 2026 14:16:11 +0000
Subject: [PATCH] Freeze cap-only bounded schema variant for paired local
 evaluation

---
 src/reviewpulse/interpreter/structured.py | 18 +++++++++++++++++-
 tests/unit/test_structured_drafting.py    | 19 +++++++++++++++++++
 2 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/src/reviewpulse/interpreter/structured.py b/src/reviewpulse/interpreter/structured.py
index 0738169b..890b6a4f 100644
--- a/src/reviewpulse/interpreter/structured.py
+++ b/src/reviewpulse/interpreter/structured.py
@@ -18,6 +18,9 @@ from .units import convert
 from .validate import validate_program
 
 
+WIRE_NODE_LIMIT = 64
+
+
 class SlotDraft(FlatProgram):
     subject: str = Field(min_length=1, description="Exact subject phrase from the supplied source")
     evidence_requests: list[EvidenceRequest] = Field(default_factory=list)
@@ -52,6 +55,19 @@ Return JSON matching the schema. The resulting draft requires human approval."""
 def slot_schema(catalogue: dict, context: ContextBundle) -> dict:
     schema = SlotDraft.model_json_schema()
     node = schema["$defs"]["FlatNode"]["properties"]
+    # A reference cannot be a quantity or source sentence. The finite wire
+    # budget bounds pathological lists, independently of regulatory limits.
+    reference = {"type": "string", "pattern": r"^n[0-9]{1,3}$"}
+    for field in ("id", "left", "right", "where", "body", "node_filter", "edge_filter"):
+        node[field] = dict(reference)
+    node["args"] = {"type": "array", "items": reference, "maxItems": WIRE_NODE_LIMIT}
+    node["variable"] = {"type": "string", "pattern": r"^\$[A-Za-z][A-Za-z0-9_]*$"}
+    schema["properties"]["nodes"]["maxItems"] = WIRE_NODE_LIMIT
+    schema["properties"]["unresolved"] = {
+        "type": "array", "items": {"type": "string", "maxLength": 512}, "maxItems": 8}
+    for field in ("requirement", "applicability", "exemption"):
+        schema["properties"][field] = dict(reference) if field == "requirement" else {
+            "anyOf": [dict(reference), {"type": "null"}]}
     node["name"] = {"anyOf": [{"type": "string", "enum": sorted(catalogue["bindings"]) + ["id"]}, {"type": "null"}]}
     collections = sorted(catalogue["collections"])
     node["collection"] = {"anyOf": ([{"type": "string", "enum": collections}] if collections else []) + [{"type": "null"}]}
@@ -121,7 +137,7 @@ def wire_contract(schema: dict) -> dict:
             "node_forms": [{"ops": choice["properties"]["op"]["enum"],
                             "required_fields": choice["required"]}
                            for choice in schema["$defs"]["FlatNode"]["oneOf"]],
-            "references": "left/right, args, where/body, requirement/applicability/exemption reference unique node ids",
+            "references": "Use unique short node ids n0, n1, etc. left/right, args, where/body and roots reference those ids",
             "sources": "array of objects containing clause and exact quote"}
 
 
diff --git a/tests/unit/test_structured_drafting.py b/tests/unit/test_structured_drafting.py
index 544734a0..55f9db6a 100644
--- a/tests/unit/test_structured_drafting.py
+++ b/tests/unit/test_structured_drafting.py
@@ -119,3 +119,22 @@ def test_dimensionless_multiplier_does_not_become_a_count():
     })
     program = compile_slots(frame, context, catalogue_from(inputs, None))
     assert program.requirement.left.right.unit == "1"
+
+
+def test_wire_schema_excludes_sentences_and_quantities_as_references():
+    import re
+
+    from reviewpulse.interpreter.structured import slot_schema
+
+    context, inputs, _ = case()
+    schema = slot_schema(catalogue_from(inputs, None), context)
+    assert schema["properties"]["nodes"]["maxItems"] == 64
+    pattern = schema["properties"]["requirement"]["pattern"]
+    assert re.fullmatch(pattern, "n12")
+    assert not re.fullmatch(pattern, "1.4 m")
+    assert not re.fullmatch(pattern, "The full source sentence")
+    for form in schema["$defs"]["FlatNode"]["oneOf"]:
+        assert form["properties"]["id"]["pattern"] == pattern
+        for name in ("left", "right", "body", "where", "node_filter", "edge_filter"):
+            if name in form["properties"]:
+                assert form["properties"][name]["pattern"] == pattern
