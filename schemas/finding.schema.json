{
 "$defs": {
  "Assessment": {
   "properties": {
    "outcome": {
     "enum": [
      "SATISFIED",
      "VIOLATED",
      "UNRESOLVED",
      "NOT_APPLICABLE",
      "EXEMPT"
     ],
     "title": "Outcome",
     "type": "string"
    },
    "evidence_issues": {
     "items": {
      "$ref": "#/$defs/EvidenceIssue"
     },
     "title": "Evidence Issues",
     "type": "array"
    },
    "severity": {
     "enum": [
      "CRITICAL",
      "MAJOR",
      "MINOR"
     ],
     "title": "Severity",
     "type": "string"
    },
    "rule_authority": {
     "enum": [
      "APPROVED_REQUIREMENT",
      "ADVISORY_GUIDANCE"
     ],
     "title": "Rule Authority",
     "type": "string"
    },
    "dependencies": {
     "items": {
      "type": "string"
     },
     "title": "Dependencies",
     "type": "array"
    }
   },
   "required": [
    "outcome",
    "severity",
    "rule_authority"
   ],
   "title": "Assessment",
   "type": "object"
  },
  "EvidenceIssue": {
   "properties": {
    "code": {
     "$ref": "#/$defs/IssueCode"
    },
    "detail": {
     "title": "Detail",
     "type": "string"
    }
   },
   "required": [
    "code",
    "detail"
   ],
   "title": "EvidenceIssue",
   "type": "object"
  },
  "IssueCode": {
   "enum": [
    "UNCERTAIN_SCALE",
    "UNKNOWN_CLASS",
    "INCOMPLETE_INVENTORY",
    "MISSING_CONNECTION",
    "POSSIBLE_TEXT_OMISSION",
    "UNVERIFIED_GEOMETRY",
    "MISSING_INPUT",
    "TOLERANCE_BAND"
   ],
   "title": "IssueCode",
   "type": "string"
  }
 },
 "description": "One rule result (the Judge's output, `findings.json`).",
 "properties": {
  "rule_id": {
   "title": "Rule Id",
   "type": "string"
  },
  "verdict": {
   "enum": [
    "PASS",
    "WARNING",
    "FAIL",
    "NOT_EVALUATED"
   ],
   "title": "Verdict",
   "type": "string"
  },
  "severity": {
   "enum": [
    "critical",
    "major",
    "minor",
    "info"
   ],
   "title": "Severity",
   "type": "string"
  },
  "subject_ids": {
   "description": "Rooms or elements the finding is about.",
   "items": {
    "type": "string"
   },
   "title": "Subject Ids",
   "type": "array"
  },
  "message": {
   "title": "Message",
   "type": "string"
  },
  "detected": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "What was measured, e.g. `0.70 m`.",
   "title": "Detected"
  },
  "required": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "What the rule requires, e.g. `>= 0.80 m`.",
   "title": "Required"
  },
  "tier": {
   "enum": [
    "T1",
    "T2",
    "T3"
   ],
   "title": "Tier",
   "type": "string"
  },
  "evidence": {
   "additionalProperties": true,
   "description": "Witness path, dimension chain, polygons to draw.",
   "title": "Evidence",
   "type": "object"
  },
  "source": {
   "additionalProperties": true,
   "description": "Requirement source: `{doc, clause, span}`.",
   "title": "Source",
   "type": "object"
  },
  "assessment": {
   "anyOf": [
    {
     "$ref": "#/$defs/Assessment"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  }
 },
 "required": [
  "rule_id",
  "verdict",
  "severity",
  "subject_ids",
  "message",
  "tier"
 ],
 "title": "Finding",
 "type": "object"
}
