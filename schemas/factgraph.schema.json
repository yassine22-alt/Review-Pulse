   "title": "Bindings",
   "type": "object"
  },
  "nodes": {
   "items": {
    "$ref": "#/$defs/Node"
   },
   "title": "Nodes",
   "type": "array"
  },
  "edges": {
   "items": {
    "$ref": "#/$defs/Edge"
   },
   "title": "Edges",
   "type": "array"
  },
  "inventory": {
   "additionalProperties": {
    "$ref": "#/$defs/Inventory"
   },
   "description": "Per node kind the producer looked for, including kinds with no member found (an empty collection is different from a kind nobody looked for)",
   "title": "Inventory",
   "type": "object"
  },
  "graph_complete": {
   "default": false,
   "description": "Every relation is listed, so 'no route' can be proven",
   "title": "Graph Complete",
   "type": "boolean"
  }
 },
