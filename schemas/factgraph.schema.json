     "type": "string"
    },
    "tier": {
     "default": "unknown",
     "enum": [
      "T1",
      "T2",
      "T3",
      "unknown"
     ],
     "title": "Tier",
     "type": "string"
    },
    "scale": {
     "default": "unknown",
     "description": "Method that fixed the scale, or unknown",
     "title": "Scale",
     "type": "string"
    },
    "producer": {
     "default": "",
     "title": "Producer",
     "type": "string"
    }
   },
   "title": "Provenance",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "format_version": {
   "const": "1.0",
   "default": "1.0",
   "title": "Format Version",
   "type": "string"
  },
  "provenance": {
   "$ref": "#/$defs/Provenance"
  },
  "bindings": {
   "additionalProperties": {
    "$ref": "#/$defs/Binding"
   },
