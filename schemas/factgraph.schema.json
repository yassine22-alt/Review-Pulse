   "title": "Binding",
   "type": "object"
  },
  "Edge": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "minLength": 1,
     "title": "Id",
     "type": "string"
    },
    "a": {
     "title": "A",
     "type": "string"
    },
    "b": {
     "title": "B",
     "type": "string"
    },
    "kind": {
     "description": "door, opening, window, adjacent, ...",
     "minLength": 1,
     "title": "Kind",
     "type": "string"
    },
    "via": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
