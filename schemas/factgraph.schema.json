     "title": "Trusted",
     "type": "boolean"
    },
    "attrs": {
     "additionalProperties": {
      "$ref": "#/$defs/Fact"
     },
     "title": "Attrs",
     "type": "object"
    }
   },
   "required": [
    "id",
    "a",
    "b",
    "kind"
   ],
   "title": "Edge",
   "type": "object"
  },
  "Fact": {
   "additionalProperties": false,
   "properties": {
    "value": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "integer"
      },
      {
       "type": "number"
      },
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value"
    },
    "source": {
     "minLength": 1,
     "title": "Source",
     "type": "string"
    },
    "trusted": {
     "default": false,
     "title": "Trusted",
     "type": "boolean"
    },
    "conflicting": {
     "default": false,
     "title": "Conflicting",
     "type": "boolean"
    }
   },
   "required": [
    "source"
   ],
   "title": "Fact",
   "type": "object"
  },
  "Inventory": {
   "additionalProperties": false,
   "properties": {
    "complete": {
     "default": false,
     "description": "Every member of this kind is listed (reviewed or exact)",
     "title": "Complete",
     "type": "boolean"
    },
    "trusted": {
     "default": false,
     "description": "Membership is established, so a listed member really exists",
     "title": "Trusted",
     "type": "boolean"
    }
   },
   "title": "Inventory",
   "type": "object"
  },
  "Node": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "minLength": 1,
     "title": "Id",
     "type": "string"
    },
    "kind": {
     "description": "Any name the producer declares: room, stair, duct, span, sheet, ...",
     "minLength": 1,
     "title": "Kind",
     "type": "string"
    },
    "role": {
     "default": "member",
     "description": "member: one of many things of its kind (listed in a collection); whole: the subject as a whole (building, site, structure) carrying global facts; boundary: where things lead to (outside, an exit) rather than a thing to measure",
     "enum": [
      "member",
      "whole",
      "boundary"
     ],
     "title": "Role",
     "type": "string"
    },
    "label": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Text as drawn, or a schedule tag",
     "title": "Label"
    },
    "attrs": {
     "additionalProperties": {
      "$ref": "#/$defs/Fact"
     },
     "description": "Measured facts, each with source and trust",
     "title": "Attrs",
     "type": "object"
    }
   },
   "required": [
    "id",
    "kind"
   ],
   "title": "Node",
   "type": "object"
  },
  "Provenance": {
   "additionalProperties": false,
   "properties": {
    "document": {
     "default": "",
